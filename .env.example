# Copy to .env and adjust as needed. .env is gitignored.

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=vitals.raw
KAFKA_TOPIC_DEADLETTER=vitals.deadletter
KAFKA_CONSUMER_GROUP=vitals-ingest

# --- Lakehouse (local Delta table paths) ---
LAKEHOUSE_ROOT=./lakehouse
BRONZE_PATH=./lakehouse/bronze/vitals
SILVER_PATH=./lakehouse/silver/vitals
GOLD_PATH=./lakehouse/gold/news2_scores

# --- Great Expectations ---
GX_ROOT=./gx

# --- OpenLineage ---
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=clinical-vitals-capstone
# For local runs without a Marquez server, events are written to a file instead:
OPENLINEAGE_TRANSPORT=file
OPENLINEAGE_FILE_PATH=./lineage_events.jsonl

# --- RAG ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=clinical_guidelines
# fastembed (ONNX) model names
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
CORPUS_DIR=./corpus
# where fastembed / huggingface_hub cache the ONNX model files
FASTEMBED_CACHE_PATH=./models
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# retrieval params
RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_TOP_N=5
RAG_MIN_RERANK_SCORE=-6.0
